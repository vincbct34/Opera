# Example environment file for the project.
# Copy this file to `.env` and replace the placeholder values with your real secrets.
# Do NOT commit your real `.env` to version control.

# Database connection (example formats)
# - Local Postgres: "postgres://USER:PASSWORD@HOST:PORT/DATABASE"
# - Prisma Data Proxy / managed connection (example): "prisma+postgres://<HOST>/?api_key=YOUR_API_KEY"
DATABASE_URL="postgres://user:password@localhost:5432/opera_db"

# JWT Secrets - replace with strong random strings (keep secret)
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
JWT_REFRESH_SECRET="your-refresh-token-secret"
ACCESS_TOKEN_SECRET="your-access-token-secret"

# Application settings
NODE_ENV="development"
# Server-side absolute URL used to generate links in emails and server-side code.
# Prefer setting APP_URL in production (server-only). If client-side code needs a base URL
# (for example when the browser needs to build absolute links), set `NEXT_PUBLIC_BASE_URL`.
# Note: any variable prefixed with NEXT_PUBLIC_ is exposed to the browser and MUST NOT contain secrets.
APP_URL="http://localhost:3000"
# Search engine indexing control
# Set to "true" to keep the site accessible but removed from search indexes
SITE_NOINDEX="false"

# Email service configuration (SMTP2GO API)
# Documentation: https://www.smtp2go.com/docs/api/
SMTP2GO_API_KEY="api-YOUR_API_KEY"
SMTP_FROM_NAME="Plateforme de l'Opéra"
SMTP_FROM_EMAIL="noreply@example.com"
# Email address for the "Préparation musicale" contact form
OPERA_ADMIN_EMAIL="example@oonm.fr"

# Optional: any additional environment variables used by your project can go below.
# For production, consider using a secrets manager or environment configuration service.

# CORS allowed origins (comma-separated). If not set, defaults to localhost and placeholder.fr
ALLOWED_ORIGINS="http://localhost:3000,https://your-production-domain.com"

# Redis Configuration (Required for production with multiple instances)
# For distributed CSRF protection and rate limiting
# Example: "redis://localhost:6379" or "redis://user:password@host:port/db"
REDIS_URL="redis://localhost:6379"

# Cron Job Authentication (Required in production)
# Secret token for authenticating cron endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET="your-secure-cron-secret-token-here"
